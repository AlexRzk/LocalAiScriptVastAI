#!/usr/bin/env bash
set -Eeuo pipefail

STATE_DIR="${VAST_LLM_STATE_DIR:-/data/vast-llm}"
PROFILES_DIR="$STATE_DIR/profiles"
CURRENT_FILE="$STATE_DIR/current_profile"
API_KEY_FILE="$STATE_DIR/api_key.txt"
RESULTS_DIR="$STATE_DIR/benchmarks"
mkdir -p "$RESULTS_DIR"

c_reset='\033[0m'; c_bold='\033[1m'; c_green='\033[32m'; c_yellow='\033[33m'; c_red='\033[31m'; c_cyan='\033[36m'
if [[ -n "${NO_COLOR:-}" ]]; then c_reset=''; c_bold=''; c_green=''; c_yellow=''; c_red=''; c_cyan=''; fi
info() { printf '%b%s%b\n' "$c_cyan" "$*" "$c_reset" >&2; }
ok() { printf '%b%s%b\n' "$c_green" "$*" "$c_reset" >&2; }
warn() { printf '%b%s%b\n' "$c_yellow" "$*" "$c_reset" >&2; }
die() { printf '%bERROR: %s%b\n' "$c_red" "$*" "$c_reset" >&2; exit 1; }

ensure_tools() {
  command -v curl >/dev/null 2>&1 || die 'curl is required.'
  command -v python3 >/dev/null 2>&1 || die 'python3 is required.'
  if ! command -v jq >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
      info 'Installing jq ...'
      apt-get update -qq
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq jq >/dev/null
    else
      die 'jq is required.'
    fi
  fi
}

current_profile() {
  if [[ -s "$CURRENT_FILE" ]]; then cat "$CURRENT_FILE"; else printf 'default'; fi
}

sanitize_profile() {
  local p="$1"
  [[ "$p" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid profile '$p'."
  printf '%s' "$p"
}

load_profile() {
  local p="$1" f
  p="$(sanitize_profile "$p")"
  f="$PROFILES_DIR/$p.env"
  [[ -f "$f" ]] || die "Profile '$p' does not exist."

  MODEL_REPO='unknown'
  MODEL_FILE='unknown.gguf'
  ALIAS_BASE='model'
  GPU_IDS='0'
  PORT_BASE='8000'
  CONTEXT='65536'
  PARALLEL='1'
  CACHE_K='unknown'
  CACHE_V='unknown'
  MTP_ENABLED='0'
  MTP_DRAFT_MAX='0'
  MTP_P_MIN='0'
  REASONING_MODE='default'
  REASONING_BUDGET=''
  FLASH_ATTN='auto'
  CACHE_REUSE='0'

  # Profiles are generated by vast-llm and shell-escaped on write.
  # shellcheck disable=SC1090
  source "$f"
}

endpoint_for() {
  local p="$1" idx="${2:-0}"
  load_profile "$p"
  BENCH_PORT=$((PORT_BASE + idx))
  IFS=',' read -r -a _bench_gpus <<< "$GPU_IDS"
  if (( ${#_bench_gpus[@]} > 1 )); then
    BENCH_ALIAS="${ALIAS_BASE}-${idx}"
  else
    BENCH_ALIAS="$ALIAS_BASE"
  fi
}

api_key() {
  [[ -s "$API_KEY_FILE" ]] || die "API key missing: $API_KEY_FILE. Run: vast-llm key"
  tr -d '\r\n' < "$API_KEY_FILE"
}

check_server() {
  local p="$1" idx="${2:-0}" key code
  endpoint_for "$p" "$idx"
  key="$(api_key)"
  code="$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $key" "http://127.0.0.1:${BENCH_PORT}/props" || true)"
  [[ "$code" == 200 ]] || die "Profile '$p' replica $idx is not reachable/authenticated on port $BENCH_PORT (HTTP $code)."
}

runtime_context() {
  local p="$1" idx="${2:-0}" key
  endpoint_for "$p" "$idx"
  key="$(api_key)"
  curl -s -H "Authorization: Bearer $key" "http://127.0.0.1:${BENCH_PORT}/props" |
    jq -r '[.. | objects | .n_ctx? // empty] | map(select(type=="number")) | .[0] // 0'
}

now_ms() {
  python3 - <<'PY'
import time
print(int(time.time() * 1000))
PY
}

chat_payload() {
  local model="$1" prompt="$2" max_tokens="$3" temperature="${4:-0}"
  jq -cn --arg model "$model" --arg prompt "$prompt" --argjson max "$max_tokens" --argjson temp "$temperature" \
    '{model:$model,messages:[{role:"user",content:$prompt}],max_tokens:$max,temperature:$temp,stream:false}'
}

chat_request() {
  local p="$1" idx="$2" prompt="$3" max_tokens="$4" temperature="${5:-0}" key payload
  endpoint_for "$p" "$idx"
  key="$(api_key)"
  payload="$(chat_payload "$BENCH_ALIAS" "$prompt" "$max_tokens" "$temperature")"
  curl -sS "http://127.0.0.1:${BENCH_PORT}/v1/chat/completions" \
    -H "Authorization: Bearer $key" \
    -H 'Content-Type: application/json' \
    --data-binary "$payload"
}

response_text() {
  jq -r '((.choices[0].message.content // "") + "\n" + (.choices[0].message.reasoning_content // ""))'
}

metric_json() {
  local response="$1" elapsed_ms="$2"
  jq -cn --argjson r "$response" --argjson elapsed "$elapsed_ms" '
    {
      prompt_tokens: ($r.usage.prompt_tokens // 0),
      output_tokens: ($r.usage.completion_tokens // 0),
      prompt_tok_s: ($r.timings.prompt_per_second // 0),
      generation_tok_s: ($r.timings.predicted_per_second // 0),
      generation_ms: ($r.timings.predicted_ms // 0),
      wall_ms: $elapsed,
      mtp_drafted: ($r.timings.draft_n // 0),
      mtp_accepted: ($r.timings.draft_n_accepted // 0),
      finish_reason: ($r.choices[0].finish_reason // "unknown"),
      error: ($r.error.message // null)
    }
  '
}

single_speed_run() {
  local p="$1" idx="$2" prompt response start end
  prompt='Write a technically dense explanation of transformer inference optimization covering attention, KV cache, quantization, batching, speculative decoding and GPU memory bandwidth. Use several paragraphs and continue until the token limit.'
  start="$(now_ms)"
  response="$(chat_request "$p" "$idx" "$prompt" 512 0.2)"
  end="$(now_ms)"
  metric_json "$response" "$((end-start))"
}

speed_test() {
  local p="$1" idx="$2" runs="${3:-1}" i result='[]' one
  info "[speed] $runs generation run(s), 512 output-token cap"
  for ((i=1; i<=runs; i++)); do
    info "  run $i/$runs"
    one="$(single_speed_run "$p" "$idx")"
    result="$(jq -cn --argjson a "$result" --argjson x "$one" '$a + [$x]')"
  done
  jq -cn --argjson runs "$result" '
    {
      runs:$runs,
      avg_generation_tok_s: (([$runs[].generation_tok_s] | add) / ($runs|length)),
      avg_prompt_tok_s: (([$runs[].prompt_tok_s] | add) / ($runs|length)),
      avg_wall_ms: (([$runs[].wall_ms] | add) / ($runs|length)),
      avg_mtp_acceptance: (if ([$runs[].mtp_drafted] | add) > 0 then (([$runs[].mtp_accepted] | add) / ([$runs[].mtp_drafted] | add)) else null end)
    }'
}

make_prefill_prompt() {
  local words="$1"
  python3 - "$words" <<'PY'
import sys
n=int(sys.argv[1])
base=("GPU inference requires careful coordination of memory bandwidth, cache locality, batching, scheduling, "
      "attention kernels, quantization and host-device transfers. ")
text=[]
count=0
while count < n:
    text.append(base)
    count += len(base.split())
print("Read the following synthetic technical corpus. At the end, answer only PREFILL_OK.\n\n" + ''.join(text) + "\n\nAnswer only PREFILL_OK.")
PY
}

prefill_test() {
  local p="$1" idx="$2" words="$3" prompt response start end metric text pass
  info "[prefill] synthetic prompt ~${words} words"
  prompt="$(make_prefill_prompt "$words")"
  start="$(now_ms)"
  response="$(chat_request "$p" "$idx" "$prompt" 16 0)"
  end="$(now_ms)"
  metric="$(metric_json "$response" "$((end-start))")"
  text="$(printf '%s' "$response" | response_text)"
  pass=false; grep -qi 'PREFILL_OK' <<< "$text" && pass=true
  jq -cn --argjson m "$metric" --argjson pass "$pass" --argjson words "$words" '$m + {approx_input_words:$words, retrieval_pass:$pass}'
}

ask_exact() {
  local p="$1" idx="$2" prompt="$3" expected="$4" response text pass=false
  response="$(chat_request "$p" "$idx" "$prompt" 96 0)"
  text="$(printf '%s' "$response" | response_text | tr '\n' ' ')"
  grep -Fqi "$expected" <<< "$text" && pass=true
  jq -cn --arg expected "$expected" --arg answer "$text" --argjson pass "$pass" '{pass:$pass,expected:$expected,answer:($answer[0:240])}'
}

reasoning_test() {
  local p="$1" idx="$2" a b c d result score
  info '[reasoning] deterministic arithmetic and logic'
  a="$(ask_exact "$p" "$idx" 'Compute 17*23 - 19*11. Return only the final integer.' '182')"
  b="$(ask_exact "$p" "$idx" 'Sequence: 2, 6, 12, 20, 30. Return only the next integer.' '42')"
  c="$(ask_exact "$p" "$idx" 'All zorps are flims. No flims are taves. Can any zorp be a tave? Answer only YES or NO.' 'NO')"
  d="$(ask_exact "$p" "$idx" 'A $120 item is discounted by 25%, then the discounted price is increased by 20%. Return only the final price as a number.' '108')"
  result="$(jq -cn --argjson a "$a" --argjson b "$b" --argjson c "$c" --argjson d "$d" '[$a,$b,$c,$d]')"
  score="$(jq '[.[]|select(.pass==true)]|length' <<< "$result")"
  jq -cn --argjson cases "$result" --argjson score "$score" '{score:$score,max:4,cases:$cases}'
}

coding_test() {
  local p="$1" idx="$2" a b c d result score
  info '[coding] code execution reasoning and bug recognition'
  a="$(ask_exact "$p" "$idx" $'What does this Python print? Return only the integer.\n\nprint(sum(i*i for i in range(1,8) if i%2==0))' '56')"
  b="$(ask_exact "$p" "$idx" $'What does this JavaScript expression evaluate to? Return only the integer.\n\n[1,2,3,4].map(x=>x*2).filter(x=>x>5).reduce((a,b)=>a+b,0)' '14')"
  c="$(ask_exact "$p" "$idx" $'Name the Python bug in five words or fewer:\n\ndef add(x, items=[]):\n    items.append(x)\n    return items' 'mutable default')"
  d="$(ask_exact "$p" "$idx" $'What is printed? Return only the text.\n\nx = {"a": 1, "b": 2}\nprint("-".join(sorted(x.keys(), reverse=True)))' 'b-a')"
  result="$(jq -cn --argjson a "$a" --argjson b "$b" --argjson c "$c" --argjson d "$d" '[$a,$b,$c,$d]')"
  score="$(jq '[.[]|select(.pass==true)]|length' <<< "$result")"
  jq -cn --argjson cases "$result" --argjson score "$score" '{score:$score,max:4,cases:$cases}'
}

instruction_test() {
  local p="$1" idx="$2" response content cleaned pass=false
  info '[instruction] exact structured-output compliance'
  response="$(chat_request "$p" "$idx" 'Return exactly this JSON object and nothing else: {"status":"ok","value":17}' 64 0)"
  content="$(jq -r '.choices[0].message.content // ""' <<< "$response")"
  cleaned="$(sed -e 's/^```json[[:space:]]*//' -e 's/^```[[:space:]]*//' -e 's/[[:space:]]*```$//' <<< "$content")"
  if jq -e '.status=="ok" and .value==17 and (keys|sort)==["status","value"]' >/dev/null 2>&1 <<< "$cleaned"; then pass=true; fi
  jq -cn --argjson pass "$pass" --arg answer "$content" '{score:(if $pass then 1 else 0 end),max:1,pass:$pass,answer:($answer[0:240])}'
}

tool_test() {
  local p="$1" idx="$2" key payload response name args pass=false
  endpoint_for "$p" "$idx"
  key="$(api_key)"
  info '[tool] OpenAI-compatible function call'
  payload="$(jq -cn --arg model "$BENCH_ALIAS" '{
    model:$model,
    messages:[{role:"user",content:"Call get_weather for Paris, France. Do not answer directly; use the tool."}],
    temperature:0,
    max_tokens:128,
    tools:[{type:"function",function:{name:"get_weather",description:"Get current weather for a city",parameters:{type:"object",properties:{city:{type:"string"}},required:["city"],additionalProperties:false}}}],
    tool_choice:"auto"
  }')"
  response="$(curl -sS "http://127.0.0.1:${BENCH_PORT}/v1/chat/completions" -H "Authorization: Bearer $key" -H 'Content-Type: application/json' --data-binary "$payload")"
  name="$(jq -r '.choices[0].message.tool_calls[0].function.name // ""' <<< "$response")"
  args="$(jq -r '.choices[0].message.tool_calls[0].function.arguments // ""' <<< "$response")"
  if [[ "$name" == get_weather ]] && grep -qi 'Paris' <<< "$args"; then pass=true; fi
  jq -cn --argjson pass "$pass" --arg name "$name" --arg args "$args" --arg finish "$(jq -r '.choices[0].finish_reason // ""' <<< "$response")" \
    '{score:(if $pass then 1 else 0 end),max:1,pass:$pass,function:$name,arguments:$args,finish_reason:$finish}'
}

make_needle_prompt() {
  local words="$1" secret="$2"
  python3 - "$words" "$secret" <<'PY'
import sys
words=int(sys.argv[1]); secret=sys.argv[2]
filler="Distributed inference systems coordinate tensors, kernels, queues, caches, schedulers and memory transfers across accelerators. "
parts=[]; count=0
half=max(1, words//2)
while count < half:
    parts.append(filler); count += len(filler.split())
parts.append(f" IMPORTANT RECORD: the secret benchmark token is {secret}. ")
while count < words:
    parts.append(filler); count += len(filler.split())
print("Search the corpus below. Return only the secret benchmark token, with no explanation.\n\n" + ''.join(parts))
PY
}

needle_test() {
  local p="$1" idx="$2" words="$3" secret prompt response start end metric text pass=false
  secret="VAST-NEEDLE-$((10000 + RANDOM % 89999))"
  info "[context] needle retrieval at ~${words} words"
  prompt="$(make_needle_prompt "$words" "$secret")"
  start="$(now_ms)"
  response="$(chat_request "$p" "$idx" "$prompt" 64 0)"
  end="$(now_ms)"
  metric="$(metric_json "$response" "$((end-start))")"
  text="$(printf '%s' "$response" | response_text)"
  grep -Fq "$secret" <<< "$text" && pass=true
  jq -cn --argjson m "$metric" --arg secret "$secret" --argjson pass "$pass" --argjson words "$words" \
    '$m + {approx_input_words:$words,pass:$pass,secret:$secret}'
}

gpu_snapshot() {
  local p="$1" first_gpu
  load_profile "$p"
  first_gpu="${GPU_IDS%%,*}"; first_gpu="${first_gpu//[[:space:]]/}"
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi -i "$first_gpu" --query-gpu=name,memory.used,memory.total,power.draw,power.limit,temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1 || true
  fi
}

summary_line() {
  local file="$1"
  jq -r '[.profile,.model_file,(.runtime_context|tostring),(.summary.quality_score|tostring)+"/"+(.summary.quality_max|tostring),((.summary.quality_pct|tostring)+"%"),((.tests.speed.avg_generation_tok_s // 0)|tostring),((.tests.speed.avg_prompt_tok_s // 0)|tostring),((.tests.speed.avg_mtp_acceptance // 0)*100|floor|tostring)+"%"]|@tsv' "$file"
}

print_summary() {
  local file="$1"
  echo
  printf '%bBenchmark result%b\n' "$c_bold" "$c_reset"
  jq -r '
    "  Profile:        \(.profile)",
    "  Model:          \(.model_file)",
    "  Runtime ctx:    \(.runtime_context)",
    "  Quality:        \(.summary.quality_score)/\(.summary.quality_max) (\(.summary.quality_pct)%)",
    "  Generation:     \((.tests.speed.avg_generation_tok_s // 0)|floor) tok/s",
    "  Prompt prefill: \((.tests.speed.avg_prompt_tok_s // 0)|floor) tok/s",
    "  MTP acceptance: \(if .tests.speed.avg_mtp_acceptance == null then "n/a" else ((.tests.speed.avg_mtp_acceptance*100)|floor|tostring)+"%" end)",
    "  Saved:          \(.result_file)"
  ' "$file"
  echo
}

run_suite() {
  local p="${1:-$(current_profile)}" idx="${2:-0}" mode="${3:-quick}" runtime speed prefill reasoning coding instruction tool needle_small needle_large='null'
  local speed_runs prefill_words needle_words large_words quality_score quality_max quality_pct timestamp file gpu meta
  p="$(sanitize_profile "$p")"
  [[ "$mode" == quick || "$mode" == full ]] || die 'Suite mode must be quick or full.'
  ensure_tools
  check_server "$p" "$idx"
  endpoint_for "$p" "$idx"
  runtime="$(runtime_context "$p" "$idx")"
  load_profile "$p"

  if [[ "$mode" == full ]]; then speed_runs=3; prefill_words=16000; else speed_runs=1; prefill_words=6000; fi
  needle_words=$(( runtime / 12 ))
  (( needle_words < 2500 )) && needle_words=2500
  (( needle_words > 12000 )) && needle_words=12000
  large_words=$(( runtime / 3 ))
  (( large_words > 50000 )) && large_words=50000

  echo
  printf '%bVast LLM %s benchmark%b — %s (port %s)\n' "$c_bold" "${mode^^}" "$c_reset" "$p" "$BENCH_PORT"
  printf 'Configured context: %s | Runtime context: %s\n\n' "$CONTEXT" "$runtime"

  speed="$(speed_test "$p" "$idx" "$speed_runs")"
  prefill="$(prefill_test "$p" "$idx" "$prefill_words")"
  reasoning="$(reasoning_test "$p" "$idx")"
  coding="$(coding_test "$p" "$idx")"
  instruction="$(instruction_test "$p" "$idx")"
  tool="$(tool_test "$p" "$idx")"
  needle_small="$(needle_test "$p" "$idx" "$needle_words")"
  if [[ "$mode" == full && "$runtime" =~ ^[0-9]+$ ]] && (( runtime >= 65536 )); then
    needle_large="$(needle_test "$p" "$idx" "$large_words")"
  fi

  quality_score="$(jq -n --argjson r "$reasoning" --argjson c "$coding" --argjson i "$instruction" --argjson t "$tool" --argjson n "$needle_small" --argjson nl "$needle_large" \
    '($r.score+$c.score+$i.score+$t.score+(if $n.pass then 1 else 0 end)+(if $nl==null then 0 elif $nl.pass then 1 else 0 end))')"
  quality_max="$(jq -n --argjson r "$reasoning" --argjson c "$coding" --argjson i "$instruction" --argjson t "$tool" --argjson nl "$needle_large" \
    '($r.max+$c.max+$i.max+$t.max+1+(if $nl==null then 0 else 1 end))')"
  quality_pct="$(awk -v a="$quality_score" -v b="$quality_max" 'BEGIN { if (b==0) print 0; else printf "%.1f",100*a/b }')"
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  file="$RESULTS_DIR/${timestamp}-${p}-${mode}.json"
  gpu="$(gpu_snapshot "$p")"

  meta="$(jq -cn \
    --arg profile "$p" --arg mode "$mode" --arg model_repo "$MODEL_REPO" --arg model_file "$MODEL_FILE" --arg alias "$BENCH_ALIAS" \
    --argjson port "$BENCH_PORT" --argjson configured_context "$CONTEXT" --argjson runtime_context "$runtime" \
    --arg gpu_ids "$GPU_IDS" --arg cache_k "$CACHE_K" --arg cache_v "$CACHE_V" --arg flash "$FLASH_ATTN" \
    --argjson mtp_enabled "$MTP_ENABLED" --argjson mtp_draft "$MTP_DRAFT_MAX" --arg mtp_pmin "$MTP_P_MIN" \
    --arg reasoning "$REASONING_MODE" --arg reasoning_budget "${REASONING_BUDGET:-default}" --arg cache_reuse "$CACHE_REUSE" --arg gpu "$gpu" \
    '{profile:$profile,mode:$mode,model_repo:$model_repo,model_file:$model_file,alias:$alias,port:$port,configured_context:$configured_context,runtime_context:$runtime_context,gpu_ids:$gpu_ids,config:{cache_k:$cache_k,cache_v:$cache_v,flash_attention:$flash,mtp_enabled:($mtp_enabled==1),mtp_draft_max:$mtp_draft,mtp_p_min:$mtp_pmin,reasoning:$reasoning,reasoning_budget:$reasoning_budget,cache_reuse:$cache_reuse},gpu_snapshot:$gpu}')"

  jq -n --argjson meta "$meta" --arg timestamp "$timestamp" --arg result_file "$file" \
    --argjson speed "$speed" --argjson prefill "$prefill" --argjson reasoning "$reasoning" --argjson coding "$coding" \
    --argjson instruction "$instruction" --argjson tool "$tool" --argjson needle "$needle_small" --argjson needle_large "$needle_large" \
    --argjson quality_score "$quality_score" --argjson quality_max "$quality_max" --argjson quality_pct "$quality_pct" \
    '$meta + {timestamp:$timestamp,result_file:$result_file,tests:{speed:$speed,prefill:$prefill,reasoning:$reasoning,coding:$coding,instruction:$instruction,tool_call:$tool,needle:$needle,needle_large:$needle_large},summary:{quality_score:$quality_score,quality_max:$quality_max,quality_pct:$quality_pct}}' > "$file"

  ok "Benchmark saved: $file"
  print_summary "$file"
}

latest_result() {
  local p="$1" mode="${2:-}"
  local pattern
  if [[ -n "$mode" ]]; then pattern="$RESULTS_DIR"/*-"$p"-"$mode".json; else pattern="$RESULTS_DIR"/*-"$p"-*.json; fi
  # shellcheck disable=SC2086
  ls -1t $pattern 2>/dev/null | head -n1 || true
}

compare_files() {
  local a="$1" b="$2"
  [[ -f "$a" && -f "$b" ]] || die 'Comparison results are missing.'
  echo
  printf '%bModel comparison%b\n\n' "$c_bold" "$c_reset"
  printf '%-16s %-32s %10s %10s %10s %10s %9s\n' 'PROFILE' 'MODEL' 'CTX' 'QUALITY' 'GEN t/s' 'PP t/s' 'MTP acc'
  printf '%-16s %-32s %10s %10s %10s %10s %9s\n' '----------------' '--------------------------------' '----------' '----------' '----------' '----------' '---------'
  while IFS=$'\t' read -r profile model ctx quality pct gen pp mtp; do
    printf '%-16s %-32.32s %10s %10s %10.1f %10.1f %9s\n' "$profile" "$model" "$ctx" "$quality" "$gen" "$pp" "$mtp"
  done < <(summary_line "$a"; summary_line "$b")
  echo
  jq -n --slurpfile a "$a" --slurpfile b "$b" '
    {
      faster_generation: (if $a[0].tests.speed.avg_generation_tok_s >= $b[0].tests.speed.avg_generation_tok_s then $a[0].profile else $b[0].profile end),
      better_quality: (if $a[0].summary.quality_pct >= $b[0].summary.quality_pct then $a[0].profile else $b[0].profile end),
      generation_speed_ratio_A_over_B: (($a[0].tests.speed.avg_generation_tok_s / ($b[0].tests.speed.avg_generation_tok_s + 0.000001))*100|round/100)
    }'
}

cmd_compare() {
  local p1="${1:-}" p2="${2:-}" mode="${3:-quick}" a b
  [[ -n "$p1" && -n "$p2" ]] || die 'Usage: vast-llm bench-compare <profile1> <profile2> [quick|full]'
  run_suite "$p1" 0 "$mode"
  run_suite "$p2" 0 "$mode"
  a="$(latest_result "$p1" "$mode")"; b="$(latest_result "$p2" "$mode")"
  compare_files "$a" "$b"
}

cmd_history() {
  ensure_tools
  echo
  printf '%bRecent benchmark results%b\n\n' "$c_bold" "$c_reset"
  printf '%-21s %-15s %-8s %-9s %-11s %-11s %s\n' 'TIMESTAMP' 'PROFILE' 'MODE' 'QUALITY' 'GEN tok/s' 'CTX' 'MODEL'
  local f count=0
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    jq -r '[.timestamp,.profile,.mode,((.summary.quality_score|tostring)+"/"+(.summary.quality_max|tostring)),((.tests.speed.avg_generation_tok_s // 0)|tostring),(.runtime_context|tostring),.model_file]|@tsv' "$f"
    count=$((count+1)); (( count >= 15 )) && break
  done < <(find "$RESULTS_DIR" -maxdepth 1 -type f -name '*.json' -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d' ' -f2-)
}

cmd_speed() {
  local p="${1:-$(current_profile)}" idx="${2:-0}" runs="${3:-3}"
  ensure_tools; check_server "$p" "$idx"
  speed_test "$p" "$idx" "$runs" | jq
}

cmd_needle() {
  local p="${1:-$(current_profile)}" words="${2:-12000}" idx="${3:-0}"
  ensure_tools; check_server "$p" "$idx"
  needle_test "$p" "$idx" "$words" | jq
}

cmd_quality() {
  local p="${1:-$(current_profile)}" idx="${2:-0}"
  ensure_tools; check_server "$p" "$idx"
  jq -n --argjson reasoning "$(reasoning_test "$p" "$idx")" --argjson coding "$(coding_test "$p" "$idx")" --argjson instruction "$(instruction_test "$p" "$idx")" --argjson tool "$(tool_test "$p" "$idx")" \
    '{reasoning:$reasoning,coding:$coding,instruction:$instruction,tool_call:$tool}'
}

cmd_custom() {
  local p="${1:-$(current_profile)}" idx="${2:-0}" prompt max response start end metric
  ensure_tools; check_server "$p" "$idx"
  read -r -p 'Custom benchmark prompt: ' prompt
  read -r -p 'Max output tokens [512]: ' max; max="${max:-512}"
  start="$(now_ms)"; response="$(chat_request "$p" "$idx" "$prompt" "$max" 0.2)"; end="$(now_ms)"
  metric="$(metric_json "$response" "$((end-start))")"
  echo; echo 'Metrics:'; jq <<< "$metric"
  echo; echo 'Answer:'; jq -r '.choices[0].message.content // ""' <<< "$response"
}

menu() {
  local choice cur p1 p2 mode words
  while true; do
    cur="$(current_profile)"
    echo
    printf '%bBenchmark Center%b — current: %s\n' "$c_bold" "$c_reset" "$cur"
    cat <<'EOF'
  1) Quick benchmark suite
  2) Full benchmark suite
  3) Raw generation speed (3 runs)
  4) Reasoning + coding + tool quality
  5) Long-context needle test
  6) Compare two profiles — quick
  7) Compare two profiles — full
  8) Benchmark history
  9) Custom prompt benchmark
  0) Back
EOF
    read -r -p 'Choose: ' choice || return
    case "$choice" in
      1) run_suite "$cur" 0 quick ;;
      2) run_suite "$cur" 0 full ;;
      3) cmd_speed "$cur" 0 3 ;;
      4) cmd_quality "$cur" 0 ;;
      5) read -r -p 'Approximate input words [12000]: ' words; cmd_needle "$cur" "${words:-12000}" 0 ;;
      6) read -r -p 'Profile A: ' p1; read -r -p 'Profile B: ' p2; cmd_compare "$p1" "$p2" quick ;;
      7) read -r -p 'Profile A: ' p1; read -r -p 'Profile B: ' p2; cmd_compare "$p1" "$p2" full ;;
      8) cmd_history ;;
      9) cmd_custom "$cur" 0 ;;
      0) return ;;
      *) warn 'Unknown choice.' ;;
    esac
  done
}

usage() {
  cat <<'EOF'
Vast LLM Benchmark Center

Commands:
  vast-llm benchmarks                         Open benchmark menu
  vast-llm bench-suite [profile] [quick|full]
  vast-llm bench-compare <profileA> <profileB> [quick|full]
  vast-llm bench-speed [profile] [replica] [runs]
  vast-llm bench-quality [profile] [replica]
  vast-llm bench-needle [profile] [words] [replica]
  vast-llm bench-history
  vast-llm bench-custom [profile] [replica]

The suite stores JSON results under /data/vast-llm/benchmarks.
EOF
}

case "${1:-menu}" in
  menu|benchmarks|center) menu ;;
  suite) shift; run_suite "${1:-$(current_profile)}" 0 "${2:-quick}" ;;
  compare) shift; cmd_compare "$@" ;;
  speed) shift; cmd_speed "$@" ;;
  quality) shift; cmd_quality "$@" ;;
  needle) shift; cmd_needle "$@" ;;
  history) cmd_history ;;
  custom) shift; cmd_custom "$@" ;;
  help|-h|--help) usage ;;
  *) usage; die "Unknown benchmark command '$1'" ;;
esac
