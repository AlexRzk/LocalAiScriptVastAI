#!/usr/bin/env bash
set -Eeuo pipefail
STATE_DIR="${VAST_LLM_STATE_DIR:-/data/vast-llm}"; PROFILES_DIR="$STATE_DIR/profiles"; CURRENT_FILE="$STATE_DIR/current_profile"; API_KEY_FILE="$STATE_DIR/api_key.txt"; RESULTS_DIR="$STATE_DIR/benchmarks"
mkdir -p "$RESULTS_DIR"
c_reset='\033[0m'; c_bold='\033[1m'; c_green='\033[32m'; c_yellow='\033[33m'; c_red='\033[31m'; c_cyan='\033[36m'
[[ -z "${NO_COLOR:-}" ]] || { c_reset=''; c_bold=''; c_green=''; c_yellow=''; c_red=''; c_cyan=''; }
info(){ printf '%b%s%b\n' "$c_cyan" "$*" "$c_reset" >&2; }; ok(){ printf '%b%s%b\n' "$c_green" "$*" "$c_reset" >&2; }; warn(){ printf '%b%s%b\n' "$c_yellow" "$*" "$c_reset" >&2; }; die(){ printf '%bERROR: %s%b\n' "$c_red" "$*" "$c_reset" >&2; exit 1; }
ensure_tools(){ command -v curl >/dev/null || die 'curl is required.'; command -v python3 >/dev/null || die 'python3 is required.'; if ! command -v jq >/dev/null; then command -v apt-get >/dev/null || die 'jq is required.'; info 'Installing jq ...'; apt-get update -qq; DEBIAN_FRONTEND=noninteractive apt-get install -y -qq jq >/dev/null; fi; }
current_profile(){ [[ -s "$CURRENT_FILE" ]] && cat "$CURRENT_FILE" || printf default; }
sanitize_profile(){ [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid profile '$1'."; printf '%s' "$1"; }
load_profile(){ local p f; p="$(sanitize_profile "$1")"; f="$PROFILES_DIR/$p.env"; [[ -f "$f" ]] || die "Profile '$p' does not exist."; MODEL_REPO=unknown; MODEL_FILE=unknown.gguf; ALIAS_BASE=model; GPU_IDS=0; PORT_BASE=8000; CONTEXT=65536; PARALLEL=1; CACHE_K=unknown; CACHE_V=unknown; MTP_ENABLED=0; MTP_DRAFT_MAX=0; MTP_P_MIN=0; REASONING_MODE=default; REASONING_BUDGET=''; FLASH_ATTN=auto; CACHE_REUSE=0; source "$f"; }
endpoint_for(){ local p="$1" idx="${2:-0}"; load_profile "$p"; BENCH_PORT=$((PORT_BASE+idx)); IFS=',' read -r -a _bench_gpus <<< "$GPU_IDS"; (( ${#_bench_gpus[@]} > 1 )) && BENCH_ALIAS="${ALIAS_BASE}-${idx}" || BENCH_ALIAS="$ALIAS_BASE"; }
api_key(){ [[ -s "$API_KEY_FILE" ]] || die "API key missing: $API_KEY_FILE"; tr -d '\r\n' < "$API_KEY_FILE"; }
check_server(){ local key code; endpoint_for "$1" "${2:-0}"; key="$(api_key)"; code="$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $key" "http://127.0.0.1:${BENCH_PORT}/props" || true)"; [[ "$code" == 200 ]] || die "Profile '$1' replica ${2:-0} is not ready on port $BENCH_PORT (HTTP $code)."; }
runtime_context(){ local key; endpoint_for "$1" "${2:-0}"; key="$(api_key)"; curl -s -H "Authorization: Bearer $key" "http://127.0.0.1:${BENCH_PORT}/props" | jq -r '[..|objects|.n_ctx?//empty]|map(select(type=="number"))|.[0]//0'; }
now_ms(){ python3 - <<'PY'
import time
print(int(time.time()*1000))
PY
}
nonce(){ printf '%s-%s-%s' "$(date +%s%N 2>/dev/null || date +%s)" "$RANDOM" "$$"; }
chat_payload(){ local model="$1" prompt="$2" max="$3" temp="${4:-0}" reasoning="${5:-default}"; if [[ "$reasoning" == no ]]; then jq -cn --arg m "$model" --arg p "$prompt" --argjson x "$max" --argjson t "$temp" '{model:$m,messages:[{role:"user",content:$p}],max_tokens:$x,temperature:$t,stream:false,reasoning_effort:"none",chat_template_kwargs:{enable_thinking:false}}'; else jq -cn --arg m "$model" --arg p "$prompt" --argjson x "$max" --argjson t "$temp" '{model:$m,messages:[{role:"user",content:$p}],max_tokens:$x,temperature:$t,stream:false}'; fi; }
chat_request(){ local key payload; endpoint_for "$1" "$2"; key="$(api_key)"; payload="$(chat_payload "$BENCH_ALIAS" "$3" "$4" "${5:-0}" "${6:-default}")"; curl -sS "http://127.0.0.1:${BENCH_PORT}/v1/chat/completions" -H "Authorization: Bearer $key" -H 'Content-Type: application/json' --data-binary "$payload"; }
response_content(){ jq -r '.choices[0].message.content//""'; }; response_reasoning(){ jq -r '.choices[0].message.reasoning_content//""'; }
metric_json(){ jq -cn --argjson r "$1" --argjson elapsed "$2" '{prompt_tokens:($r.usage.prompt_tokens//0),output_tokens:($r.usage.completion_tokens//0),prompt_tok_s:($r.timings.prompt_per_second//0),generation_tok_s:($r.timings.predicted_per_second//0),prompt_ms:($r.timings.prompt_ms//0),generation_ms:($r.timings.predicted_ms//0),wall_ms:$elapsed,mtp_drafted:($r.timings.draft_n//0),mtp_accepted:($r.timings.draft_n_accepted//0),finish_reason:($r.choices[0].finish_reason//"unknown"),error:($r.error.message//null)}'; }
single_speed_run(){ local marker prompt response a b; marker="$(nonce)"; prompt="Benchmark nonce ${marker}. Write a technically dense explanation of transformer inference optimization covering attention, KV cache, quantization, batching, speculative decoding and GPU memory bandwidth. Continue until the token limit."; a="$(now_ms)"; response="$(chat_request "$1" "$2" "$prompt" 512 0.2)"; b="$(now_ms)"; metric_json "$response" "$((b-a))"; }
speed_test(){ local p="$1" idx="$2" runs="${3:-1}" i all='[]' one; info "[speed] $runs uncached generation run(s)"; for ((i=1;i<=runs;i++)); do info "  run $i/$runs"; one="$(single_speed_run "$p" "$idx")"; all="$(jq -cn --argjson a "$all" --argjson x "$one" '$a+[$x]')"; done; jq -cn --argjson r "$all" '([$r[].output_tokens]|add) as $ot|([$r[].generation_ms]|add) as $gm|([$r[].prompt_tokens]|add) as $pt|([$r[].prompt_ms]|add) as $pm|{runs:$r,total_output_tokens:$ot,total_generation_ms:$gm,total_prompt_tokens:$pt,total_prompt_ms:$pm,avg_generation_tok_s:(if $gm>0 then $ot*1000/$gm else ([$r[].generation_tok_s]|add)/($r|length) end),avg_prompt_tok_s:(if $pm>0 then $pt*1000/$pm else ([$r[].prompt_tok_s]|add)/($r|length) end),avg_wall_ms:(([$r[].wall_ms]|add)/($r|length)),avg_mtp_acceptance:(if ([$r[].mtp_drafted]|add)>0 then ([$r[].mtp_accepted]|add)/([$r[].mtp_drafted]|add) else null end)}'; }
make_prefill_prompt(){ python3 - "$1" "$2" <<'PY'
import sys
n=int(sys.argv[1]); marker=sys.argv[2]; base='GPU inference requires careful coordination of memory bandwidth, cache locality, batching, scheduling, attention kernels, quantization and host-device transfers. '; parts=[]; c=0
while c<n: parts.append(base); c+=len(base.split())
print(f'UNIQUE BENCHMARK NONCE {marker}. Read the corpus. At the end answer only PREFILL_OK.\n\n'+''.join(parts)+'\n\nAnswer only PREFILL_OK.')
PY
}
prefill_test(){ local marker prompt response a b metric text pass=false; info "[prefill] uncached synthetic prompt ~${3} words"; marker="$(nonce)"; prompt="$(make_prefill_prompt "$3" "$marker")"; a="$(now_ms)"; response="$(chat_request "$1" "$2" "$prompt" 32 0 no)"; b="$(now_ms)"; metric="$(metric_json "$response" "$((b-a))")"; text="$(printf '%s' "$response"|response_content)"; grep -Fqi PREFILL_OK <<< "$text" && pass=true; jq -cn --argjson m "$metric" --argjson pass "$pass" --argjson words "$3" '$m+{approx_input_words:$words,retrieval_pass:$pass}'; }
normalize_answer(){ python3 -c 'import re,sys;s=sys.stdin.read().strip();s=re.sub(r"^```(?:json|text|python|javascript)?\s*","",s,flags=re.I);s=re.sub(r"\s*```$","",s);s=s.strip().strip("`").strip().strip(chr(34)).strip();s=re.sub(r"\s+"," ",s);print(s.casefold())'; }
answer_result(){ local content reasoning got want pass=false finish; content="$(printf '%s' "$1"|response_content)"; reasoning="$(printf '%s' "$1"|response_reasoning)"; got="$(printf '%s' "$content"|normalize_answer)"; want="$(printf '%s' "$2"|normalize_answer)"; finish="$(jq -r '.choices[0].finish_reason//"unknown"' <<< "$1")"; if [[ "$3" == contains ]]; then [[ "$got" == *"$want"* ]] && pass=true; else [[ "$got" == "$want" ]] && pass=true; fi; jq -cn --arg expected "$2" --arg answer "$content" --arg reasoning "$reasoning" --arg finish "$finish" --argjson pass "$pass" '{pass:$pass,expected:$expected,answer:($answer[0:240]),reasoning_excerpt:($reasoning[0:240]),finish_reason:$finish}'; }
ask_exact(){ local r; r="$(chat_request "$1" "$2" "$3" 512 0 no)"; answer_result "$r" "$4" exact; }; ask_contains(){ local r; r="$(chat_request "$1" "$2" "$3" 512 0 no)"; answer_result "$r" "$4" contains; }
reasoning_test(){ local a b c d cases score; info '[correctness/reasoning] deterministic checks (thinking disabled)'; a="$(ask_exact "$1" "$2" 'Compute 17*23 - 19*11. Return only the final integer.' 182)"; b="$(ask_exact "$1" "$2" 'Sequence: 2, 6, 12, 20, 30. Return only the next integer.' 42)"; c="$(ask_exact "$1" "$2" 'All zorps are flims. No flims are taves. Can any zorp be a tave? Answer only YES or NO.' NO)"; d="$(ask_exact "$1" "$2" 'A $120 item is discounted by 25%, then increased by 20%. Return only the final price as a number.' 108)"; cases="$(jq -cn --argjson a "$a" --argjson b "$b" --argjson c "$c" --argjson d "$d" '[$a,$b,$c,$d]')"; score="$(jq '[.[]|select(.pass)]|length' <<< "$cases")"; jq -cn --argjson cases "$cases" --argjson score "$score" '{score:$score,max:4,cases:$cases}'; }
coding_test(){ local a b c d cases score; info '[correctness/coding] deterministic checks (thinking disabled)'; a="$(ask_exact "$1" "$2" $'What does this Python print? Return only the integer.\n\nprint(sum(i*i for i in range(1,8) if i%2==0))' 56)"; b="$(ask_exact "$1" "$2" $'What does this JavaScript expression evaluate to? Return only the integer.\n\n[1,2,3,4].map(x=>x*2).filter(x=>x>5).reduce((a,b)=>a+b,0)' 14)"; c="$(ask_contains "$1" "$2" $'Name the Python bug in five words or fewer:\n\ndef add(x, items=[]):\n items.append(x)\n return items' 'mutable default')"; d="$(ask_exact "$1" "$2" $'What is printed? Return only the text.\n\nx={"a":1,"b":2}\nprint("-".join(sorted(x.keys(),reverse=True)))' b-a)"; cases="$(jq -cn --argjson a "$a" --argjson b "$b" --argjson c "$c" --argjson d "$d" '[$a,$b,$c,$d]')"; score="$(jq '[.[]|select(.pass)]|length' <<< "$cases")"; jq -cn --argjson cases "$cases" --argjson score "$score" '{score:$score,max:4,cases:$cases}'; }
instruction_test(){ local r content cleaned pass=false; info '[agentic/instruction] structured output'; r="$(chat_request "$1" "$2" 'Return exactly this JSON object and nothing else: {"status":"ok","value":17}' 256 0 no)"; content="$(printf '%s' "$r"|response_content)"; cleaned="$(sed -e 's/^```json[[:space:]]*//' -e 's/^```[[:space:]]*//' -e 's/[[:space:]]*```$//' <<< "$content")"; jq -e '.status=="ok" and .value==17 and (keys|sort)==["status","value"]' >/dev/null 2>&1 <<< "$cleaned" && pass=true; jq -cn --argjson pass "$pass" --arg answer "$content" '{score:(if $pass then 1 else 0 end),max:1,pass:$pass,answer:($answer[0:240])}'; }
tool_test(){ local key payload r name args pass=false; endpoint_for "$1" "$2"; key="$(api_key)"; info '[agentic/tool] OpenAI-compatible function call'; payload="$(jq -cn --arg m "$BENCH_ALIAS" '{model:$m,messages:[{role:"user",content:"Call get_weather for Paris, France. Use the tool."}],temperature:0,max_tokens:256,reasoning_effort:"none",chat_template_kwargs:{enable_thinking:false},tools:[{type:"function",function:{name:"get_weather",description:"Get weather",parameters:{type:"object",properties:{city:{type:"string"}},required:["city"],additionalProperties:false}}}],tool_choice:"auto"}')"; r="$(curl -sS "http://127.0.0.1:${BENCH_PORT}/v1/chat/completions" -H "Authorization: Bearer $key" -H 'Content-Type: application/json' --data-binary "$payload")"; name="$(jq -r '.choices[0].message.tool_calls[0].function.name//""' <<< "$r")"; args="$(jq -r '.choices[0].message.tool_calls[0].function.arguments//""' <<< "$r")"; [[ "$name" == get_weather ]] && grep -qi Paris <<< "$args" && pass=true; jq -cn --argjson pass "$pass" --arg name "$name" --arg args "$args" '{score:(if $pass then 1 else 0 end),max:1,pass:$pass,function:$name,arguments:$args}'; }
make_needle_prompt(){ python3 - "$1" "$2" "$3" <<'PY'
import sys
n=int(sys.argv[1]); secret=sys.argv[2]; marker=sys.argv[3]; filler='Distributed inference systems coordinate tensors, kernels, queues, caches, schedulers and memory transfers across accelerators. '; parts=[]; c=0; half=max(1,n//2)
while c<half: parts.append(filler); c+=len(filler.split())
parts.append(f' IMPORTANT RECORD: the secret benchmark token is {secret}. ')
while c<n: parts.append(filler); c+=len(filler.split())
print(f'UNIQUE BENCHMARK NONCE {marker}. Return only the secret benchmark token.\n\n'+''.join(parts))
PY
}
needle_test(){ local secret marker prompt r a b metric text pass=false; secret="VAST-NEEDLE-$((10000+RANDOM%89999))"; marker="$(nonce)"; info "[context] uncached needle retrieval at ~${3} words"; prompt="$(make_needle_prompt "$3" "$secret" "$marker")"; a="$(now_ms)"; r="$(chat_request "$1" "$2" "$prompt" 256 0 no)"; b="$(now_ms)"; metric="$(metric_json "$r" "$((b-a))")"; text="$(printf '%s' "$r"|response_content)"; grep -Fq "$secret" <<< "$text" && pass=true; jq -cn --argjson m "$metric" --arg secret "$secret" --argjson pass "$pass" --argjson words "$3" '$m+{approx_input_words:$words,pass:$pass,secret:$secret}'; }
gpu_snapshot(){ load_profile "$1"; local gpu="${GPU_IDS%%,*}"; gpu="${gpu//[[:space:]]/}"; command -v nvidia-smi >/dev/null && nvidia-smi -i "$gpu" --query-gpu=name,memory.used,memory.total,power.draw,power.limit,temperature.gpu --format=csv,noheader,nounits 2>/dev/null|head -n1 || true; }
summary_line(){ jq -r '[.profile,.model_file,(.runtime_context|tostring),((.summary.correctness_score//.summary.quality_score//0)|tostring)+"/"+((.summary.correctness_max//.summary.quality_max//0)|tostring),((.summary.agentic_score//0)|tostring)+"/"+((.summary.agentic_max//0)|tostring),((.summary.context_score//0)|tostring)+"/"+((.summary.context_max//0)|tostring),((.tests.speed.avg_generation_tok_s//0)|tostring),((.tests.prefill.prompt_tok_s//.tests.speed.avg_prompt_tok_s//0)|tostring),(if .tests.speed.avg_mtp_acceptance==null then "n/a" else ((.tests.speed.avg_mtp_acceptance*100)|floor|tostring)+"%" end)]|@tsv' "$1"; }
print_summary(){ echo; printf '%bBenchmark result%b\n' "$c_bold" "$c_reset"; jq -r '"  Profile:             \(.profile)","  Model:               \(.model_file)","  Runtime ctx:         \(.runtime_context)","","  Performance","    Generation:        \((.tests.speed.avg_generation_tok_s//0)*10|round/10) tok/s","    Long prefill:      \((.tests.prefill.prompt_tok_s//0)*10|round/10) tok/s","    MTP acceptance:    \(if .tests.speed.avg_mtp_acceptance==null then "n/a" else ((.tests.speed.avg_mtp_acceptance*1000)|round/10|tostring)+"%" end)","","  Correctness:         \(.summary.correctness_score)/\(.summary.correctness_max)","  Agentic/API:         \(.summary.agentic_score)/\(.summary.agentic_max)","  Context retrieval:   \(.summary.context_score)/\(.summary.context_max)","  Checks passed:       \(.summary.checks_score)/\(.summary.checks_max) (\(.summary.checks_pct)%)","","  Saved:               \(.result_file)"' "$1"; echo; }
run_suite(){ local p="${1:-$(current_profile)}" idx="${2:-0}" mode="${3:-quick}" runtime speed prefill reasoning coding instruction tool small large='null' speed_runs prefill_words needle_words large_words cs cm as am xs xm total max pct ts file gpu meta; p="$(sanitize_profile "$p")"; [[ "$mode" == quick || "$mode" == full ]] || die 'Suite mode must be quick or full.'; ensure_tools; check_server "$p" "$idx"; endpoint_for "$p" "$idx"; runtime="$(runtime_context "$p" "$idx")"; load_profile "$p"; if [[ "$mode" == full ]]; then speed_runs=3; prefill_words=16000; else speed_runs=1; prefill_words=6000; fi; needle_words=$((runtime/12)); ((needle_words<2500))&&needle_words=2500; ((needle_words>12000))&&needle_words=12000; large_words=$((runtime/3)); ((large_words>50000))&&large_words=50000; echo; printf '%bVast LLM %s benchmark%b — %s (port %s)\n' "$c_bold" "${mode^^}" "$c_reset" "$p" "$BENCH_PORT"; speed="$(speed_test "$p" "$idx" "$speed_runs")"; prefill="$(prefill_test "$p" "$idx" "$prefill_words")"; reasoning="$(reasoning_test "$p" "$idx")"; coding="$(coding_test "$p" "$idx")"; instruction="$(instruction_test "$p" "$idx")"; tool="$(tool_test "$p" "$idx")"; small="$(needle_test "$p" "$idx" "$needle_words")"; if [[ "$mode" == full && "$runtime" =~ ^[0-9]+$ ]] && ((runtime>=65536)); then large="$(needle_test "$p" "$idx" "$large_words")"; fi; cs="$(jq -n --argjson r "$reasoning" --argjson c "$coding" '$r.score+$c.score')"; cm=8; as="$(jq -n --argjson i "$instruction" --argjson t "$tool" '$i.score+$t.score')"; am=2; xs="$(jq -n --argjson s "$small" --argjson l "$large" '(if $s.pass then 1 else 0 end)+(if $l==null then 0 elif $l.pass then 1 else 0 end)')"; xm="$(jq -n --argjson l "$large" '1+(if $l==null then 0 else 1 end)')"; total=$((cs+as+xs)); max=$((cm+am+xm)); pct="$(awk -v a="$total" -v b="$max" 'BEGIN{printf "%.1f",100*a/b}')"; ts="$(date -u +%Y%m%dT%H%M%SZ)"; file="$RESULTS_DIR/${ts}-${p}-${mode}.json"; gpu="$(gpu_snapshot "$p")"; meta="$(jq -cn --arg p "$p" --arg mode "$mode" --arg repo "$MODEL_REPO" --arg model "$MODEL_FILE" --arg alias "$BENCH_ALIAS" --argjson port "$BENCH_PORT" --argjson cc "$CONTEXT" --argjson rc "$runtime" --arg gpus "$GPU_IDS" --arg gpu "$gpu" '{benchmark_schema_version:2,profile:$p,mode:$mode,model_repo:$repo,model_file:$model,alias:$alias,port:$port,configured_context:$cc,runtime_context:$rc,gpu_ids:$gpus,gpu_snapshot:$gpu}')"; jq -n --argjson meta "$meta" --arg ts "$ts" --arg file "$file" --argjson speed "$speed" --argjson prefill "$prefill" --argjson reasoning "$reasoning" --argjson coding "$coding" --argjson instruction "$instruction" --argjson tool "$tool" --argjson small "$small" --argjson large "$large" --argjson cs "$cs" --argjson cm "$cm" --argjson as "$as" --argjson am "$am" --argjson xs "$xs" --argjson xm "$xm" --argjson total "$total" --argjson max "$max" --argjson pct "$pct" '$meta+{timestamp:$ts,result_file:$file,tests:{speed:$speed,prefill:$prefill,reasoning:$reasoning,coding:$coding,instruction:$instruction,tool_call:$tool,needle:$small,needle_large:$large},summary:{correctness_score:$cs,correctness_max:$cm,agentic_score:$as,agentic_max:$am,context_score:$xs,context_max:$xm,checks_score:$total,checks_max:$max,checks_pct:$pct,quality_score:$total,quality_max:$max,quality_pct:$pct}}' > "$file"; ok "Benchmark saved: $file"; print_summary "$file"; }
latest_result(){ local pattern; [[ -n "${2:-}" ]] && pattern="$RESULTS_DIR"/*-"$1"-"$2".json || pattern="$RESULTS_DIR"/*-"$1"-*.json; ls -1t $pattern 2>/dev/null|head -n1||true; }
compare_files(){ [[ -f "$1" && -f "$2" ]] || die 'Comparison results missing.'; printf '%-15s %-28s %9s %9s %9s %9s %10s %10s %9s\n' PROFILE MODEL CTX CORRECT AGENT CONTEXT GEN_t/s PP_t/s MTP; while IFS=$'\t' read -r p m c co a x g pp mtp; do printf '%-15s %-28.28s %9s %9s %9s %9s %10.1f %10.1f %9s\n' "$p" "$m" "$c" "$co" "$a" "$x" "$g" "$pp" "$mtp"; done < <(summary_line "$1"; summary_line "$2"); }
cmd_compare(){ [[ -n "${1:-}" && -n "${2:-}" ]] || die 'Usage: bench-compare profile1 profile2'; run_suite "$1" 0 "${3:-quick}"; run_suite "$2" 0 "${3:-quick}"; compare_files "$(latest_result "$1" "${3:-quick}")" "$(latest_result "$2" "${3:-quick}")"; }
cmd_history(){ ensure_tools; printf '%-21s %-15s %-8s %-11s %-10s %-10s %-11s %s\n' TIMESTAMP PROFILE MODE CORRECT GEN_tok/s PP_tok/s CTX MODEL; local f n=0; while read -r f; do jq -r '[.timestamp,.profile,.mode,(((.summary.correctness_score//.summary.quality_score//0)|tostring)+"/"+((.summary.correctness_max//.summary.quality_max//0)|tostring)),((.tests.speed.avg_generation_tok_s//0)|tostring),((.tests.prefill.prompt_tok_s//.tests.speed.avg_prompt_tok_s//0)|tostring),(.runtime_context|tostring),.model_file]|@tsv' "$f"; n=$((n+1)); ((n>=15))&&break; done < <(find "$RESULTS_DIR" -name '*.json' -printf '%T@ %p\n'|sort -nr|cut -d' ' -f2-); }
cmd_speed(){ ensure_tools; check_server "${1:-$(current_profile)}" "${2:-0}"; speed_test "${1:-$(current_profile)}" "${2:-0}" "${3:-3}"|jq; }
cmd_needle(){ ensure_tools; check_server "${1:-$(current_profile)}" "${3:-0}"; needle_test "${1:-$(current_profile)}" "${3:-0}" "${2:-12000}"|jq; }
cmd_quality(){ local r c i t; ensure_tools; check_server "${1:-$(current_profile)}" "${2:-0}"; r="$(reasoning_test "${1:-$(current_profile)}" "${2:-0}")"; c="$(coding_test "${1:-$(current_profile)}" "${2:-0}")"; i="$(instruction_test "${1:-$(current_profile)}" "${2:-0}")"; t="$(tool_test "${1:-$(current_profile)}" "${2:-0}")"; jq -n --argjson r "$r" --argjson c "$c" --argjson i "$i" --argjson t "$t" '{correctness:{score:($r.score+$c.score),max:8,reasoning:$r,coding:$c},agentic:{score:($i.score+$t.score),max:2,instruction:$i,tool_call:$t}}'; }
cmd_custom(){ local p="${1:-$(current_profile)}" idx="${2:-0}" prompt max r a b; ensure_tools; check_server "$p" "$idx"; read -r -p 'Custom benchmark prompt: ' prompt; read -r -p 'Max output tokens [512]: ' max; max="${max:-512}"; a="$(now_ms)"; r="$(chat_request "$p" "$idx" "$prompt" "$max" 0.2)"; b="$(now_ms)"; metric_json "$r" "$((b-a))"|jq; printf '%s' "$r"|response_content; }
menu(){ local ch cur a b w; while true; do cur="$(current_profile)"; printf '\n%bBenchmark Center v2%b — current: %s\n' "$c_bold" "$c_reset" "$cur"; printf '%s\n' ' 1) Quick suite' ' 2) Full suite' ' 3) Raw speed (3 runs)' ' 4) Correctness + agentic checks' ' 5) Context needle' ' 6) Compare quick' ' 7) Compare full' ' 8) History' ' 9) Custom prompt' ' 0) Back'; read -r -p 'Choose: ' ch||return; case "$ch" in 1)run_suite "$cur" 0 quick;;2)run_suite "$cur" 0 full;;3)cmd_speed "$cur" 0 3;;4)cmd_quality "$cur" 0;;5)read -r -p 'Approx words [12000]: ' w;cmd_needle "$cur" "${w:-12000}" 0;;6)read -r -p 'Profile A: ' a;read -r -p 'Profile B: ' b;cmd_compare "$a" "$b" quick;;7)read -r -p 'Profile A: ' a;read -r -p 'Profile B: ' b;cmd_compare "$a" "$b" full;;8)cmd_history;;9)cmd_custom "$cur" 0;;0)return;;*)warn 'Unknown choice.';;esac; done; }
usage(){ printf '%s\n' 'Vast LLM Benchmark Center v2' 'Commands: benchmarks, bench-suite, bench-compare, bench-speed, bench-quality, bench-needle, bench-history, bench-custom' 'v2 reports performance, correctness, agentic/API compatibility and context separately.'; }
case "${1:-menu}" in menu|benchmarks|center)menu;;suite)shift;run_suite "${1:-$(current_profile)}" 0 "${2:-quick}";;compare)shift;cmd_compare "$@";;speed)shift;cmd_speed "$@";;quality)shift;cmd_quality "$@";;needle)shift;cmd_needle "$@";;history)cmd_history;;custom)shift;cmd_custom "$@";;help|-h|--help)usage;;*)usage;die "Unknown benchmark command '$1'";;esac
