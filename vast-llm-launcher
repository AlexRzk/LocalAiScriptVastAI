#!/usr/bin/env bash
set -u

# Interactive launcher + quick profile tuner for Vast LLM Manager.
# The core manager intentionally stays free of UI effects so it remains
# predictable in scripts, cron jobs and CI.

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORE="${VAST_LLM_CORE:-/usr/local/lib/vast-llm/vast-llm-core}"
STATE_DIR="${VAST_LLM_STATE_DIR:-/data/vast-llm}"
PROFILES_DIR="$STATE_DIR/profiles"
CURRENT_FILE="$STATE_DIR/current_profile"

if [[ ! -x "$CORE" ]]; then
  # Developer / cloned-repo fallback.
  if [[ -x "$SELF_DIR/vast-llm" ]]; then
    CORE="$SELF_DIR/vast-llm"
  else
    printf 'ERROR: vast-llm core not found. Re-run install.sh.\n' >&2
    exit 1
  fi
fi

c_reset='\033[0m'
c_bold='\033[1m'
c_green='\033[32m'
c_yellow='\033[33m'
c_red='\033[31m'
c_cyan='\033[36m'

if [[ -n "${NO_COLOR:-}" ]]; then
  c_reset=''; c_bold=''; c_green=''; c_yellow=''; c_red=''; c_cyan=''
fi

info() { printf '%b%s%b\n' "$c_cyan" "$*" "$c_reset"; }
ok() { printf '%b%s%b\n' "$c_green" "$*" "$c_reset"; }
warn() { printf '%b%s%b\n' "$c_yellow" "$*" "$c_reset" >&2; }
die() { printf '%bERROR: %s%b\n' "$c_red" "$*" "$c_reset" >&2; exit 1; }

sleep_tiny() {
  # sleep accepts fractional seconds on GNU coreutils; silently skip if not.
  sleep "$1" 2>/dev/null || true
}

splash_enabled() {
  [[ "${VAST_LLM_NO_SPLASH:-0}" != "1" ]] || return 1
  [[ -t 1 ]] || return 1
  [[ "${TERM:-dumb}" != "dumb" ]] || return 1
  return 0
}

show_splash() {
  local reset='\033[0m'
  local bold='\033[1m'
  local cyan='\033[38;5;51m'
  local blue='\033[38;5;39m'
  local violet='\033[38;5;141m'
  local dim='\033[2m'
  local green='\033[38;5;82m'

  if [[ -n "${NO_COLOR:-}" ]]; then
    reset=''; bold=''; cyan=''; blue=''; violet=''; dim=''; green=''
  fi

  printf '\033[?25l'
  trap 'printf "\033[?25h"' EXIT INT TERM

  clear 2>/dev/null || printf '\n'

  local -a art=(
'██╗   ██╗ █████╗ ███████╗████████╗      ██╗     ██╗     ███╗   ███╗'
'██║   ██║██╔══██╗██╔════╝╚══██╔══╝      ██║     ██║     ████╗ ████║'
'██║   ██║███████║███████╗   ██║         ██║     ██║     ██╔████╔██║'
'╚██╗ ██╔╝██╔══██║╚════██║   ██║         ██║     ██║     ██║╚██╔╝██║'
' ╚████╔╝ ██║  ██║███████║   ██║         ███████╗███████╗██║ ╚═╝ ██║'
'  ╚═══╝  ╚═╝  ╚═╝╚══════╝   ╚═╝         ╚══════╝╚══════╝╚═╝     ╚═╝'
  )

  local i
  for ((i = 0; i < ${#art[@]}; i++)); do
    case $((i % 3)) in
      0) printf '%b%b%s%b\n' "$bold" "$cyan" "${art[$i]}" "$reset" ;;
      1) printf '%b%b%s%b\n' "$bold" "$blue" "${art[$i]}" "$reset" ;;
      2) printf '%b%b%s%b\n' "$bold" "$violet" "${art[$i]}" "$reset" ;;
    esac
    sleep_tiny "${VAST_LLM_SPLASH_SPEED:-0.025}"
  done

  printf '\n%b      Vast.ai GPU inference control plane%b\n' "$dim" "$reset"
  printf '%b      profiles • GGUF • context • MTP • multi-GPU%b\n\n' "$dim" "$reset"

  local -a frames=('◐' '◓' '◑' '◒')
  local -a stages=('Detecting CUDA' 'Reading profiles' 'Preparing runtime' 'Ready')
  for ((i = 0; i < ${#stages[@]}; i++)); do
    printf '\r%b%s%b  %-20s' "$cyan" "${frames[$i]}" "$reset" "${stages[$i]}"
    sleep_tiny "${VAST_LLM_SPLASH_STAGE_SPEED:-0.075}"
  done
  printf '\r%b✓%b  %-20s\n\n' "$green" "$reset" 'Control plane online'

  printf '\033[?25h'
  trap - EXIT INT TERM
}

sanitize_profile_name() {
  local p="$1"
  [[ "$p" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid profile name '$p'."
  printf '%s' "$p"
}

current_profile() {
  if [[ -s "$CURRENT_FILE" ]]; then
    cat "$CURRENT_FILE"
  else
    printf 'default'
  fi
}

resolve_profile() {
  local p="${1:-}"
  [[ -n "$p" ]] || p="$(current_profile)"
  sanitize_profile_name "$p"
}

profile_file() {
  local p
  p="$(resolve_profile "$1")"
  printf '%s/%s.env' "$PROFILES_DIR" "$p"
}

load_quick_profile() {
  local p="$1" f
  f="$(profile_file "$p")"
  [[ -f "$f" ]] || die "Profile '$p' does not exist. Run: vast-llm wizard $p"

  # Defaults make the quick editor compatible with older profile files.
  CONTEXT="65536"
  PARALLEL="1"
  GPU_LAYERS="99"
  FLASH_ATTN="on"
  CACHE_K="q4_0"
  CACHE_V="q4_0"
  CACHE_REUSE="0"
  MTP_ENABLED="1"
  MTP_DRAFT_MAX="4"
  MTP_P_MIN="0.65"
  REASONING_MODE="default"
  REASONING_BUDGET=""
  GPU_IDS="0,1"
  PORT_BASE="8000"
  JINJA="1"
  NO_MMPROJ="1"
  EXTRA_ARGS=""

  # Profiles are generated by vast-llm itself and contain shell-escaped values.
  # shellcheck disable=SC1090
  source "$f"
}

validate_value() {
  local var="$1" value="$2"
  case "$var" in
    CONTEXT|PARALLEL|GPU_LAYERS|MTP_DRAFT_MAX|CACHE_REUSE)
      [[ "$value" =~ ^[0-9]+$ ]] || return 1
      ;;
    PORT_BASE)
      [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 1 && value <= 65535 )) || return 1
      ;;
    MTP_P_MIN)
      awk -v v="$value" 'BEGIN { exit !(v ~ /^[0-9]*\.?[0-9]+$/ && v >= 0 && v <= 1) }' || return 1
      ;;
    FLASH_ATTN)
      [[ "$value" == on || "$value" == off || "$value" == auto ]] || return 1
      ;;
    CACHE_K|CACHE_V)
      [[ -n "$value" ]] || return 1
      ;;
    MTP_ENABLED|JINJA|NO_MMPROJ)
      [[ "$value" == 0 || "$value" == 1 ]] || return 1
      ;;
    REASONING_MODE)
      [[ "$value" == default || "$value" == on || "$value" == off ]] || return 1
      ;;
    GPU_IDS)
      [[ "$value" =~ ^[0-9]+([[:space:]]*,[[:space:]]*[0-9]+)*$ ]] || return 1
      ;;
    REASONING_BUDGET|EXTRA_ARGS)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

update_profile_var() {
  local p="$1" var="$2" value="$3" f tmp escaped
  f="$(profile_file "$p")"
  [[ -f "$f" ]] || die "Profile '$p' does not exist."
  validate_value "$var" "$value" || die "Invalid value '$value' for $var"

  escaped="$(printf '%q' "$value")"
  tmp="${f}.tmp.$$"

  awk -v key="$var" -v replacement="$var=$escaped" '
    BEGIN { found=0 }
    index($0, key "=") == 1 { print replacement; found=1; next }
    { print }
    END { if (!found) print replacement }
  ' "$f" > "$tmp"

  chmod 600 "$tmp"
  mv "$tmp" "$f"
  ok "$p: $var=$value"
}

normalize_bool() {
  case "${1,,}" in
    1|on|yes|y|true|enabled) printf '1' ;;
    0|off|no|n|false|disabled) printf '0' ;;
    *) return 1 ;;
  esac
}

setting_to_var() {
  case "$1" in
    context|ctx) printf 'CONTEXT' ;;
    parallel|slots) printf 'PARALLEL' ;;
    gpu-layers|ngl) printf 'GPU_LAYERS' ;;
    flash|flash-attn) printf 'FLASH_ATTN' ;;
    kv-k|cache-k) printf 'CACHE_K' ;;
    kv-v|cache-v) printf 'CACHE_V' ;;
    cache-reuse|reuse) printf 'CACHE_REUSE' ;;
    mtp) printf 'MTP_ENABLED' ;;
    mtp-draft|draft) printf 'MTP_DRAFT_MAX' ;;
    mtp-pmin|pmin) printf 'MTP_P_MIN' ;;
    reasoning) printf 'REASONING_MODE' ;;
    reasoning-budget|budget) printf 'REASONING_BUDGET' ;;
    gpu|gpus) printf 'GPU_IDS' ;;
    port) printf 'PORT_BASE' ;;
    jinja) printf 'JINJA' ;;
    mmproj-disabled|no-mmproj) printf 'NO_MMPROJ' ;;
    extra|extra-args) printf 'EXTRA_ARGS' ;;
    *) return 1 ;;
  esac
}

cmd_set() {
  local setting="${1:-}" value="${2:-}" p="${3:-}" var
  [[ -n "$setting" && -n "${2+x}" ]] || die 'Usage: vast-llm set <setting> <value> [profile]'
  p="$(resolve_profile "$p")"
  var="$(setting_to_var "$setting")" || die "Unknown quick setting '$setting'. Run: vast-llm settings"

  case "$var" in
    MTP_ENABLED|JINJA|NO_MMPROJ)
      value="$(normalize_bool "$value")" || die "Use on/off, yes/no, 1/0 for $setting"
      ;;
  esac

  update_profile_var "$p" "$var" "$value"
  warn "Saved only. Restart '$p' to apply it to the running llama-server."
}

edit_prompt() {
  local p="$1" var="$2" label="$3" current="$4" value
  read -r -p "$label [$current]: " value || true
  [[ -n "$value" ]] || value="$current"
  update_profile_var "$p" "$var" "$value"
}

quick_settings_menu() {
  local p
  p="$(resolve_profile "${1:-}")"

  while true; do
    load_quick_profile "$p"
    echo
    printf '%bQuick Settings%b — profile: %s\n' "$c_bold" "$c_reset" "$p"
    printf '%s\n' 'Changes are saved immediately; restart is only done when you ask for it.'
    echo
    printf '  1) Context size             = %s\n' "$CONTEXT"
    printf '  2) Parallel slots           = %s\n' "$PARALLEL"
    printf '  3) GPU layers (-ngl)        = %s\n' "$GPU_LAYERS"
    printf '  4) Flash attention          = %s\n' "$FLASH_ATTN"
    printf '  5) KV cache K               = %s\n' "$CACHE_K"
    printf '  6) KV cache V               = %s\n' "$CACHE_V"
    printf '  7) Cache reuse              = %s\n' "$CACHE_REUSE"
    printf '  8) MTP enabled              = %s\n' "$([[ "$MTP_ENABLED" == 1 ]] && printf on || printf off)"
    printf '  9) MTP max drafted tokens   = %s\n' "$MTP_DRAFT_MAX"
    printf ' 10) MTP minimum probability  = %s\n' "$MTP_P_MIN"
    printf ' 11) Reasoning mode           = %s\n' "$REASONING_MODE"
    printf ' 12) Reasoning budget         = %s\n' "${REASONING_BUDGET:-default}"
    printf ' 13) GPU IDs                  = %s\n' "$GPU_IDS"
    printf ' 14) API port                 = %s\n' "$PORT_BASE"
    printf ' 15) Jinja                    = %s\n' "$([[ "$JINJA" == 1 ]] && printf on || printf off)"
    printf ' 16) Disable mmproj           = %s\n' "$([[ "$NO_MMPROJ" == 1 ]] && printf yes || printf no)"
    printf ' 17) Extra llama-server args  = %s\n' "${EXTRA_ARGS:-none}"
    echo
    printf '  r) Restart %s now (apply changes)\n' "$p"
    printf '  s) Show full profile\n'
    printf '  b) Back\n'
    echo

    local choice value
    read -r -p 'Change: ' choice || return
    case "$choice" in
      1) edit_prompt "$p" CONTEXT 'Context size' "$CONTEXT" ;;
      2) edit_prompt "$p" PARALLEL 'Parallel slots' "$PARALLEL" ;;
      3) edit_prompt "$p" GPU_LAYERS 'GPU layers (-ngl)' "$GPU_LAYERS" ;;
      4) edit_prompt "$p" FLASH_ATTN 'Flash attention (on/off/auto)' "$FLASH_ATTN" ;;
      5) edit_prompt "$p" CACHE_K 'KV cache K type' "$CACHE_K" ;;
      6) edit_prompt "$p" CACHE_V 'KV cache V type' "$CACHE_V" ;;
      7) edit_prompt "$p" CACHE_REUSE 'Cache reuse chunk size' "$CACHE_REUSE" ;;
      8)
        if [[ "$MTP_ENABLED" == 1 ]]; then value=0; else value=1; fi
        update_profile_var "$p" MTP_ENABLED "$value"
        ;;
      9) edit_prompt "$p" MTP_DRAFT_MAX 'MTP max drafted tokens' "$MTP_DRAFT_MAX" ;;
      10) edit_prompt "$p" MTP_P_MIN 'MTP minimum draft probability (0-1)' "$MTP_P_MIN" ;;
      11) edit_prompt "$p" REASONING_MODE 'Reasoning mode (default/on/off)' "$REASONING_MODE" ;;
      12)
        read -r -p "Reasoning budget [${REASONING_BUDGET:-default}; blank keeps current, 'default' clears]: " value || true
        if [[ "$value" == default ]]; then
          update_profile_var "$p" REASONING_BUDGET ""
        elif [[ -n "$value" ]]; then
          update_profile_var "$p" REASONING_BUDGET "$value"
        fi
        ;;
      13) edit_prompt "$p" GPU_IDS 'GPU IDs (comma separated)' "$GPU_IDS" ;;
      14) edit_prompt "$p" PORT_BASE 'First API port' "$PORT_BASE" ;;
      15)
        if [[ "$JINJA" == 1 ]]; then value=0; else value=1; fi
        update_profile_var "$p" JINJA "$value"
        ;;
      16)
        if [[ "$NO_MMPROJ" == 1 ]]; then value=0; else value=1; fi
        update_profile_var "$p" NO_MMPROJ "$value"
        ;;
      17)
        read -r -p "Extra llama-server args [${EXTRA_ARGS:-none}; blank keeps current, 'none' clears]: " value || true
        if [[ "$value" == none ]]; then
          update_profile_var "$p" EXTRA_ARGS ""
        elif [[ -n "$value" ]]; then
          update_profile_var "$p" EXTRA_ARGS "$value"
        fi
        ;;
      r|R)
        "$CORE" restart "$p"
        ;;
      s|S)
        "$CORE" show "$p"
        ;;
      b|B|0)
        return
        ;;
      *) warn 'Unknown choice.' ;;
    esac
  done
}

launcher_menu() {
  while true; do
    local cur choice
    cur="$(current_profile)"
    echo
    printf '%bVast.ai LLM Manager%b — current: %s\n' "$c_bold" "$c_reset" "$cur"
    cat <<'EOF'
  1) Quick settings / performance tuning
  2) Status
  3) Start
  4) Stop
  5) Restart
  6) Benchmark
  7) Profiles / switch profile
  8) Full configuration wizard
  9) Full manager menu
 10) Show API key
  0) Exit
EOF
    read -r -p 'Choose: ' choice || return
    case "$choice" in
      1) quick_settings_menu "$cur" ;;
      2) "$CORE" status "$cur" ;;
      3) "$CORE" start "$cur" ;;
      4) "$CORE" stop "$cur" ;;
      5) "$CORE" restart "$cur" ;;
      6) "$CORE" benchmark 0 ;;
      7)
        "$CORE" profiles
        local np
        read -r -p 'Profile to use (blank = keep current): ' np || true
        [[ -n "$np" ]] && "$CORE" use "$np"
        ;;
      8) "$CORE" wizard "$cur" ;;
      9) "$CORE" menu ;;
      10) "$CORE" key ;;
      0) return ;;
      *) warn 'Unknown choice.' ;;
    esac
  done
}

launcher_usage() {
  cat <<'EOF'
Quick tuning additions:
  vast-llm settings [profile]                 Interactive quick settings menu
  vast-llm tune [profile]                     Alias for settings
  vast-llm set <setting> <value> [profile]    Change one value without the wizard

Useful setting names:
  context, parallel, gpu-layers, flash, kv-k, kv-v, cache-reuse,
  mtp, mtp-draft, mtp-pmin, reasoning, reasoning-budget,
  gpu, port, jinja, no-mmproj, extra

Examples:
  vast-llm set context 160000 qwen38
  vast-llm set mtp-draft 6 qwen38
  vast-llm set mtp-pmin 0.60 qwen38
  vast-llm set cache-reuse 256 qwen38
  vast-llm restart qwen38
EOF
}

# The splash is meant for the interactive control panel, not every one-line CLI call.
if [[ $# -eq 0 || "${1:-}" == menu ]]; then
  if splash_enabled; then
    show_splash
  fi
fi

case "${1:-}" in
  "")
    launcher_menu
    ;;
  menu)
    launcher_menu
    ;;
  settings|tune|quick)
    quick_settings_menu "${2:-}"
    ;;
  set)
    shift
    cmd_set "$@"
    ;;
  quick-help)
    launcher_usage
    ;;
  *)
    exec "$CORE" "$@"
    ;;
esac
